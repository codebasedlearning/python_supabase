# Copy to .env.cloud (hosted project) — .env.local is generated by `sbcli local start`.
# Real environment variables override values from the file.

# Dashboard → Project Settings → Data API  (https://<project-ref>.supabase.co)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard → Project Settings → API Keys
#   legacy JWT keys ("anon" / "service_role")  OR  new keys (sb_publishable_… / sb_secret_…)
SUPABASE_ANON_KEY=eyJ...            # or SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # or SUPABASE_SECRET_KEY=sb_secret_...   (admin only, never share)

# Dashboard → "Connect" → Session pooler (IPv4-friendly). URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
